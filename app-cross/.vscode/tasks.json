{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Windows: Launch packaged app (ARM64)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-File", "${workspaceFolder}/scripts/launch-packaged-app.ps1",
                "-InstallDirectory", "${workspaceFolder}/out/install/windows-arm64"
            ],
            "problemMatcher": []
        },
        {
            "label": "Windows: Launch packaged app offline (ARM64)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-File", "${workspaceFolder}/scripts/launch-packaged-app.ps1",
                "-InstallDirectory", "${workspaceFolder}/out/install/windows-arm64", "-Demo"
            ],
            "problemMatcher": []
        },
        {
            "label": "Windows: Launch packaged app (x64)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-File", "${workspaceFolder}/scripts/launch-packaged-app.ps1",
                "-InstallDirectory", "${workspaceFolder}/out/install/windows-x64"
            ],
            "problemMatcher": []
        },
        {
            "label": "Windows: Launch packaged app offline (x64)",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile", "-File", "${workspaceFolder}/scripts/launch-packaged-app.ps1",
                "-InstallDirectory", "${workspaceFolder}/out/install/windows-x64", "-Demo"
            ],
            "problemMatcher": []
        },
        {
            "label": "CMake: Configure macOS",
            "type": "cmake",
            "command": "configure",
            "preset": "macos-clang"
        },
        {
            "label": "CMake: Install macOS Debug",
            "type": "cmake",
            "command": "install",
            "preset": "macos-debug",
            "dependsOn": "CMake: Configure macOS",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Install macOS Release",
            "type": "cmake",
            "command": "install",
            "preset": "macos-release",
            "dependsOn": "CMake: Configure macOS",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Configure Windows ARM64",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-arm64"
        },
        {
            "label": "CMake: Install Windows ARM64 Debug",
            "type": "cmake",
            "command": "install",
            "preset": "windows-arm64-debug",
            "dependsOn": "CMake: Configure Windows ARM64",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Install Windows ARM64 Release",
            "type": "cmake",
            "command": "install",
            "preset": "windows-arm64-release",
            "dependsOn": "CMake: Configure Windows ARM64",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Configure Windows x64",
            "type": "cmake",
            "command": "configure",
            "preset": "windows-x64"
        },
        {
            "label": "CMake: Install Windows x64 Debug",
            "type": "cmake",
            "command": "install",
            "preset": "windows-x64-debug",
            "dependsOn": "CMake: Configure Windows x64",
            "dependsOrder": "sequence",
            "group": "build"
        },
        {
            "label": "CMake: Install Windows x64 Release",
            "type": "cmake",
            "command": "install",
            "preset": "windows-x64-release",
            "dependsOn": "CMake: Configure Windows x64",
            "dependsOrder": "sequence",
            "group": "build"
        }
    ]
}
