{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach Windows ARM64",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Attach Windows X64",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Attach macOS ARM64",
            "type": "lldb-dap",
            "request": "attach",
            "attachCommands": [
                "process attach --pid ${command:pickProcess}"
            ]
        },
        {
            "name": "Attach macOS X64",
            "type": "lldb-dap",
            "request": "attach",
            "attachCommands": [
                "process attach --pid ${command:pickProcess}"
            ]
        }
    ]
}
