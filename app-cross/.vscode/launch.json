{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "CMake: Attach to packaged app (Windows)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "CMake: Debug installed app (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/install/macos-clang/passepartout",
            "cwd": "${workspaceFolder}/out/install/macos-clang",
            "MIMode": "lldb",
            "preLaunchTask": "CMake: Install macOS Debug"
        },
        {
            "name": "CMake: Run installed app (macOS Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/install/macos-clang/passepartout",
            "cwd": "${workspaceFolder}/out/install/macos-clang",
            "MIMode": "lldb",
            "preLaunchTask": "CMake: Install macOS Release"
        },
        {
            "name": "CMake: Debug installed tunnel (macOS)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/install/macos-clang/passepartout-tunnel",
            "args": [],
            "cwd": "${workspaceFolder}/out/install/macos-clang",
            "MIMode": "lldb",
            "preLaunchTask": "CMake: Install macOS Debug"
        },
        {
            "name": "CMake: Run installed tunnel (macOS Release)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/install/macos-clang/passepartout-tunnel",
            "args": [],
            "cwd": "${workspaceFolder}/out/install/macos-clang",
            "MIMode": "lldb",
            "preLaunchTask": "CMake: Install macOS Release"
        },
        {
            "name": "CMake: Attach to VPN plugin (Windows ARM64)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "symbolSearchPath": "${workspaceFolder}/out/build/windows-arm64/partout/bin;${workspaceFolder}/out/build/windows-arm64/Debug",
            "logging": {
                "moduleLoad": true,
                "exceptions": true
            }
        },
        {
            "name": "CMake: Attach to VPN plugin (Windows x64)",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}",
            "symbolSearchPath": "${workspaceFolder}/out/build/windows-x64/partout/bin;${workspaceFolder}/out/build/windows-x64/Debug",
            "logging": {
                "moduleLoad": true,
                "exceptions": true
            }
        }
    ]
}
