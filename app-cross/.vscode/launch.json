{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Windows ARM64 Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/windows-arm64",
            "program": "${workspaceFolder}/out/install/windows-arm64/passepartout.exe",
            "args": [],
            "preLaunchTask": "Prepare Windows ARM64 Debug"
        },
        {
            "name": "Run Windows ARM64 Release",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/windows-arm64",
            "program": "${workspaceFolder}/out/install/windows-arm64/passepartout.exe",
            "args": [],
            "preLaunchTask": "Prepare Windows ARM64 Release"
        },
        {
            "name": "Run Windows X64 Debug",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/windows-x64",
            "program": "${workspaceFolder}/out/install/windows-x64/passepartout.exe",
            "args": [],
            "preLaunchTask": "Prepare Windows X64 Debug"
        },
        {
            "name": "Run Windows X64 Release",
            "type": "cppvsdbg",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/windows-x64",
            "program": "${workspaceFolder}/out/install/windows-x64/passepartout.exe",
            "args": [],
            "preLaunchTask": "Prepare Windows X64 Release"
        },
        {
            "name": "Run macOS ARM64 Debug",
            "type": "lldb-dap",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/macos-arm64",
            "program": "${workspaceFolder}/out/install/macos-arm64/passepartout.app/Contents/MacOS/passepartout",
            "args": [],
            "preLaunchTask": "Prepare macOS ARM64 Debug"
        },
        {
            "name": "Run macOS ARM64 Release",
            "type": "lldb-dap",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/macos-arm64",
            "program": "${workspaceFolder}/out/install/macos-arm64/passepartout.app/Contents/MacOS/passepartout",
            "args": [],
            "preLaunchTask": "Prepare macOS ARM64 Release"
        },
        {
            "name": "Run macOS X64 Debug",
            "type": "lldb-dap",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/macos-x64",
            "program": "${workspaceFolder}/out/install/macos-x64/passepartout.app/Contents/MacOS/passepartout",
            "args": [],
            "preLaunchTask": "Prepare macOS X64 Debug"
        },
        {
            "name": "Run macOS X64 Release",
            "type": "lldb-dap",
            "request": "launch",
            "cwd": "${workspaceFolder}/out/install/macos-x64",
            "program": "${workspaceFolder}/out/install/macos-x64/passepartout.app/Contents/MacOS/passepartout",
            "args": [],
            "preLaunchTask": "Prepare macOS X64 Release"
        },
        {
            "name": "Attach Windows ARM64",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Attach Windows X64",
            "type": "cppvsdbg",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Attach macOS ARM64",
            "type": "lldb-dap",
            "request": "attach",
            "attachCommands": [
                "process attach --pid ${command:pickProcess}"
            ]
        },
        {
            "name": "Attach macOS X64",
            "type": "lldb-dap",
            "request": "attach",
            "attachCommands": [
                "process attach --pid ${command:pickProcess}"
            ]
        }
    ]
