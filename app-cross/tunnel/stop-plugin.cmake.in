# Runs at install time, so --prefix overrides select the correct running host.
set(PLUGIN_STOP_OPTIONS)
if(PASSEPARTOUT_INSTALL_NO_STOP_HOST)
    list(APPEND PLUGIN_STOP_OPTIONS -FailIfRunning)
endif()
execute_process(
    COMMAND "@PLUGIN_POWERSHELL@" -NoProfile -NonInteractive -ExecutionPolicy Bypass
        -File "@PLUGIN_STOP_SCRIPT@"
        -InstallDirectory "${CMAKE_INSTALL_PREFIX}"
        ${PLUGIN_STOP_OPTIONS}
    RESULT_VARIABLE PLUGIN_STOP_RESULT
)
if(NOT PLUGIN_STOP_RESULT STREQUAL "0")
    message(FATAL_ERROR "Unable to stop the installed VPN host (${PLUGIN_STOP_RESULT})")
endif()
